// Schema — SaaS Multi-tenant para Gestão de Lojas Maçônicas
// Toda entidade de negócio carrega lodgeId (tenant) e todas as
// queries da aplicação DEVEM filtrar por ele.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tenant ───────────────────────────

// Configuração global do SaaS (linha única) — editável pelo SUPER_ADMIN em
// /admin. A conta Asaas da plataforma cobra as licenças das lojas; cada loja
// tem a própria conta (Lodge.asaasApiKey) para cobrar os irmãos.
// Fallback: variáveis ASAAS_PLATFORM_API_KEY / ASAAS_PLATFORM_WEBHOOK_TOKEN.
model PlatformConfig {
  id                String   @id @default("platform")
  asaasApiKey       String?
  asaasWebhookToken String? // conferido no header asaas-access-token do webhook
  // Backup automático das lojas: conta Google do super admin conectada via
  // OAuth; o app cria a pasta "Backups NoPrumo" e guarda o id dela
  backupDriveFolderId      String?
  backupGoogleRefreshToken String?
  backupGoogleEmail        String?
  updatedAt         DateTime @updatedAt

  @@map("platform_config")
}

model Lodge {
  id                 String   @id @default(cuid())
  name               String
  number             String   @unique // nº da Loja na potência
  potencia           String? // GOB, GLESP, COMAB etc.
  oriente            String? // cidade/UF
  address            String? // endereço da sede (citado no texto das atas)
  driveFolderId      String? // pasta raiz da Loja no Google Drive
  pixKey             String? // chave Pix da Loja (recebimento das capitações)
  // Chave Pix da Bolsa de Benemerência (doações dos irmãos); se vazia, a
  // página de doação usa a chave Pix das capitações como fallback
  pixKeyBenemerencia String?
  logoUrl            String? // logo da Loja (data URI ou URL)
  // Cabeçalho institucional das atas em PDF (linhas centralizadas sob o
  // nome da Loja, ex.: título honorífico, fundação, federação) e divisa
  // exibida no rodapé de cada página
  ataCabecalho       String?
  ataDivisa          String?
  // Frequência mínima (%) nas sessões durante o processo de progressão
  // (trava da coluna Instrução e Frequência — ajuste conforme o regulamento)
  minFreqProgressao  Int      @default(50)
  // Nº de capitações vencidas para o membro ficar IRREGULAR (inadimplência)
  limiteInadimplencia Int     @default(3)
  // Licença do sistema cobrada da loja (opcional, definida no cadastro pelo
  // SUPER_ADMIN; a cobrança boleto/Pix sai da conta Asaas da plataforma)
  licencaValor      Decimal? @db.Decimal(10, 2)
  licencaChargeId   String?
  licencaInvoiceUrl String?
  // Acompanhamento do pagamento (webhook Asaas da plataforma)
  licencaStatus     LicencaStatus?
  licencaVencimento DateTime?
  licencaPagaEm     DateTime?
  // Instruções exigidas para progressão de grau (0 = sem exigência):
  // Aprendizes instruídos pelo 2º Vigilante, Companheiros pelo 1º Vigilante
  instrucoesAprendiz    Int @default(0)
  instrucoesCompanheiro Int @default(0)
  // Certificado de Visita personalizado (upload de PPTX na config da loja):
  // fundo renderizado em PDF + posições dos placeholders; null = template padrão
  certFundoPdf       Bytes?
  certLayout         Json?
  // Template HTML do convite de sessão (upload na config da loja); null = padrão.
  // Placeholders: {{LOJA}}, {{DATA}}, {{HORA}}, {{TIPO}}, {{GRAU}}, {{LINK}}, {{FRASE}}
  conviteTemplateHtml String?
  // Frase fixa do convite (saudação/texto da loja) — só data e tipo variam
  conviteFrase        String?
  // Assistente IA (chatbot): o VM pode desligar nas Configurações da Loja
  assistenteAtivo     Boolean @default(true)
  // Limites diários de perguntas ao assistente, por nível (0 = fechado ao nível)
  assistenteLimiteObreiros Int @default(20)
  assistenteLimiteOficiais Int @default(50)
  // Posição do painel de dados sobre a arte do convite (editor visual):
  // frações da imagem {x, y, w}; null = painel centralizado (padrão)
  conviteArteLayout   Json?
  // Gateway de pagamento Asaas (cobrança recorrente cartão/boleto)
  asaasApiKey        String? // API key da conta Asaas da Loja
  asaasWebhookToken  String? // token conferido no header asaas-access-token do webhook
  googleRefreshToken String? // OAuth do Google da Loja (conexão ao Drive)
  googleEmail        String? // conta Google conectada
  // Gmail da Loja (envio SMTP e leitura IMAP com senha de app);
  // se vazio, vale o fallback global GMAIL_USER/GMAIL_APP_PASSWORD do .env
  gmailUser          String?
  gmailAppPassword   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users             User[]
  degreeHistory     DegreeHistory[]
  roleHistory       RoleHistory[]
  sessions          LodgeSession[]
  attendances       Attendance[]
  instrucoes        Instrucao[]
  visitasExternas   VisitaExterna[]
  atas              Ata[]
  pranchas          Prancha[]
  documents         Document[]
  invoices          Invoice[]
  expenses          Expense[]
  categoriasFinanceiras CategoriaFinanceira[]
  transactions      Transaction[]
  donations         Donation[]
  events            CharityEvent[]
  processosAdmissao   ProcessoAdmissao[]
  processosProgressao ProcessoProgressao[]
  quittePlacets       QuittePlacet[]
  atestados           AtestadoRegularidade[]
  mutuaEntregas       MutuaEntrega[]
  afastamentos        PedidoAfastamento[]
  notifications       Notification[]
  cargosRito          CargoRito[]
  bibliotecaItens     BibliotecaItem[]
  processoDocumentos  ProcessoDocumento[]
  assistenteConversas AssistenteConversa[]

  @@map("lodges")
}

// ─────────────────────────── Usuários ───────────────────────────

enum Degree {
  APRENDIZ
  COMPANHEIRO
  MESTRE
  NA // sessões do tipo Evento — sem grau
}

enum Role {
  MEMBER // Obreiro comum
  VENERAVEL_MESTRE
  SECRETARIO
  TESOUREIRO
  CONSELHO_CONTAS // somente leitura em Secretaria/Tesouraria
  ESMOLER // Hospitaleiro — acompanha bem-estar (alertas de inadimplência e frequência)
  SUPER_ADMIN // admin master do SaaS — cria e administra lojas (tenants)
}

enum MemberStatus {
  ATIVO
  IRREGULAR // inadimplente
  LICENCIADO
  EX_MEMBRO
}

model User {
  id             String       @id @default(cuid())
  lodgeId        String
  // #16: cim/cpf/email únicos POR LOJA (@@unique no fim do modelo) — o mesmo
  // irmão pode ter filiação em mais de uma loja; o login por CIM pede a
  // escolha da loja quando há mais de uma (auth.ts).
  cim            String // Cadastro de Identificação Maçônica
  cpf            String
  name           String
  email          String
  phone          String?
  address        String?
  birthDate      DateTime?
  profession     String?
  // Ficha civil complementar (importada do METAGOB ou preenchida à mão)
  rg             String? // número, órgão emissor e UF em uma linha
  naturalidade   String?
  estadoCivil    String?
  conjuge        String?
  nomePai        String?
  nomeMae        String?
  tipoSanguineo  String?
  passwordHash   String
  // Força troca de senha no primeiro acesso (senha provisória = CPF)
  mustChangePassword Boolean  @default(false)
  // Recuperação de senha: código 2FA enviado por e-mail (hash bcrypt)
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeAttempts  Int       @default(0)
  // Anti-força-bruta no login: falhas consecutivas e janela de bloqueio.
  // Zeradas a cada login bem-sucedido; lockedUntil expira sozinho.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Gateway Asaas: cliente e assinatura recorrente da capitação
  asaasCustomerId     String?
  asaasSubscriptionId String?
  degree         Degree       @default(APRENDIZ)
  currentRole    Role         @default(MEMBER)
  // Cargo do rito (personalizado pela Loja) — exibição; o nível de acesso
  // continua sendo o de currentRole (cargos do rito = nível Obreiro)
  cargoRito      String?
  // Imagem da assinatura (data URI) — VM, Secretário e Orador, para assinar atas e documentos
  signatureUrl   String?
  // Foto do membro (data URI, upload pelo próprio usuário em /dashboard/perfil)
  photoUrl       String?
  status         MemberStatus @default(ATIVO)
  // Obreiro filiado (quadro de outra loja): não recolhe capitação — fica de
  // fora da geração de mensalidades e das assinaturas recorrentes do Asaas
  filiado        Boolean      @default(false)
  initiationDate DateTime? // data de iniciação (base do interstício)
  // Data de instalação como Venerável (Mestre Instalado) — importada do METAGOB
  installationDate DateTime?
  // Carteirinha digital: token opaco do QR Code de verificação pública
  // (/verificar/<token>) — regenerável para revogar carteirinhas antigas
  cardToken      String       @unique @default(cuid())

  // Painel de Privacidade (LGPD): visibilidade de contatos aos demais membros
  isDataPublic  Boolean @default(false)
  showEmail     Boolean @default(false)
  showPhone     Boolean @default(false)
  showAddress   Boolean @default(false)
  showBirthDate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge                 Lodge           @relation(fields: [lodgeId], references: [id])
  degreeHistory         DegreeHistory[]
  roleHistory           RoleHistory[]
  attendances           Attendance[]
  invoices              Invoice[]
  donations             Donation[]
  atasAsMaster          Ata[]           @relation("AtaMaster")
  atasAsSec             Ata[]           @relation("AtaSecretary")
  expensesAsMaster      Expense[]       @relation("ExpenseMaster")
  expensesAsTreasurer   Expense[]       @relation("ExpenseTreasurer")
  documentsUploaded     Document[]
  quittePlacets         QuittePlacet[]
  quittePlacetsAsMaster QuittePlacet[]  @relation("QuittePlacetMaster")
  quittePlacetsAsSec    QuittePlacet[]  @relation("QuittePlacetSecretary")
  quittePlacetsAsOrador QuittePlacet[]  @relation("QuittePlacetOrador")
  atestados             AtestadoRegularidade[] @relation("AtestadoUser")
  mutuaEntrega          MutuaEntrega?
  atestadosAsMaster     AtestadoRegularidade[] @relation("AtestadoMaster")
  atestadosAsSec        AtestadoRegularidade[] @relation("AtestadoSec")
  atestadosAsTes        AtestadoRegularidade[] @relation("AtestadoTes")
  afastamentos          PedidoAfastamento[] @relation("AfastamentoUser")
  afastamentosAsMaster  PedidoAfastamento[] @relation("AfastamentoMaster")
  afastamentosAsSec     PedidoAfastamento[] @relation("AfastamentoSec")
  notifications         Notification[]
  instrucoesRecebidas   Instrucao[]     @relation("InstrucaoUser")
  instrucoesRegistradas Instrucao[]     @relation("InstrucaoRegistrador")
  visitasExternas       VisitaExterna[] @relation("VisitaExternaUser")
  visitasRegistradas    VisitaExterna[] @relation("VisitaExternaRegistrador")
  processosProgressao   ProcessoProgressao[]
  familiares            FamilyMember[]
  bibliotecaItens       BibliotecaItem[]
  metaRegistros         MetaRegistro[]
  candidatosApadrinhados ProcessoAdmissao[] @relation("AdmissaoPadrinho")
  processosCriados       ProcessoDocumento[] @relation("ProcessoCriadoPor")
  processosAssinados     ProcessoAssinante[] @relation("ProcessoAssinanteUser")
  assistenteConversas    AssistenteConversa[]

  @@unique([lodgeId, cim])
  @@unique([lodgeId, cpf])
  @@unique([lodgeId, email])
  @@index([lodgeId])
  @@index([cim])
  @@map("users")
}

// Situação da licença do sistema cobrada da loja (conta Asaas da plataforma)
enum LicencaStatus {
  PENDENTE
  PAGA
  VENCIDA
}

// Registros trazidos do METAGOB sem equivalente editável no cadastro local:
// linha do tempo (EVENTO), cargos por período (CARGO), lojas do quadro (LOJA)
// e títulos/comendas (TITULO). Regravados por completo a cada importação.
enum MetaRegistroTipo {
  EVENTO
  CARGO
  LOJA
  TITULO
}

model MetaRegistro {
  id        String           @id @default(cuid())
  userId    String
  tipo      MetaRegistroTipo
  titulo    String // nome do evento/cargo/loja/título
  detalhe   String? // descrição longa ou complemento (loja, período…)
  data      DateTime?
  dataFim   DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
  @@map("meta_registros")
}

enum Parentesco {
  CONJUGE
  FILHO
  DEPENDENTE // dependente do Meta sem parentesco classificado
}

// Familiares do obreiro (cônjuge e filhos) — base dos alertas de aniversário.
// Cadastrado pelo Secretário/VM (ficha do membro) ou pelo próprio irmão (perfil).
model FamilyMember {
  id         String     @id @default(cuid())
  userId     String
  name       String
  parentesco Parentesco
  // Opcional: o Meta nem sempre informa — sem ela o familiar aparece na
  // ficha, mas fica fora dos alertas de aniversário
  birthDate  DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("family_members")
}

// Evolução de graus com controle de interstício
model DegreeHistory {
  id        String   @id @default(cuid())
  lodgeId   String
  userId    String
  degree    Degree
  date      DateTime // data da elevação/exaltação/iniciação
  ataId     String? // ata da sessão em que ocorreu
  createdAt DateTime @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([lodgeId])
  @@index([userId])
  @@map("degree_history")
}

// Histórico cronológico de cargos
model RoleHistory {
  id        String    @id @default(cuid())
  lodgeId   String
  userId    String
  role      Role
  cargoRito String? // nome do cargo do rito quando a nomeação for personalizada
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([lodgeId])
  @@index([userId])
  @@map("role_history")
}

// Cargos personalizados da Loja conforme o rito (ex.: Hospitaleiro,
// Mestre de Harmonia, Porta-Estandarte) — cadastrados pelo Secretário
model CargoRito {
  id        String   @id @default(cuid())
  lodgeId   String
  nome      String
  createdAt DateTime @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id])

  @@unique([lodgeId, nome])
  @@map("cargos_rito")
}

// ─────────────── Sessões, Presenças e Atas ───────────────

enum SessionType {
  ORDINARIA
  MAGNA
  ECONOMICA
  BRANCA
  EVENTO
}

model LodgeSession {
  id        String      @id @default(cuid())
  lodgeId   String
  date      DateTime
  type      SessionType @default(ORDINARIA)
  degree    Degree      @default(APRENDIZ) // grau em que a sessão foi aberta
  qrToken   String      @unique @default(cuid()) // check-in via QR Code
  // Link público do convite pré-sessão (RSVP) — /convite/[token]
  inviteToken String    @unique @default(cuid())
  // Pauta do dia — exibida no convite e pré-preenche a Ata
  pauta     String?
  createdAt DateTime    @default(now())

  lodge       Lodge        @relation(fields: [lodgeId], references: [id])
  attendances Attendance[]
  ata         Ata?

  @@index([lodgeId])
  @@map("lodge_sessions")
}

// Livro de Presenças (membros e visitantes)
model Attendance {
  id              String   @id @default(cuid())
  lodgeId         String
  sessionId       String
  userId          String? // null = visitante
  // dados do visitante
  visitorName     String?
  visitorEmail    String? // para envio do certificado de visita em PDF
  visitorCim      String?
  visitorLodge    String? // loja de origem
  visitorPotencia String? // potência de origem
  checkedInAt     DateTime @default(now())
  viaQrCode       Boolean  @default(false)
  // RSVP pré-sessão (link de convite): checkedIn=false até o check-in do dia.
  // Só registros com checkedIn=true contam como presença/frequência.
  checkedIn       Boolean  @default(true)
  rsvpAt          DateTime? // quando confirmou presença pelo convite
  agapeConfirmed  Boolean  @default(false) // ficará para o Ágape (jantar)
  // Ausência justificada (irmão avisou que não comparecerá): registro com
  // checkedIn=false — não conta frequência, mas entra na ata como justificada
  justificado     Boolean  @default(false)
  justificativa   String?

  lodge   Lodge        @relation(fields: [lodgeId], references: [id])
  session LodgeSession @relation(fields: [sessionId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([lodgeId])
  @@map("attendances")
}

// Instruções de grau ministradas pelos Vigilantes (check-in dos instruídos):
// Aprendizes com o 2º Vigilante, Companheiros com o 1º Vigilante
model Instrucao {
  id              String   @id @default(cuid())
  lodgeId         String
  userId          String // obreiro instruído
  degree          Degree // grau da instrução
  date            DateTime
  tema            String?
  registradaPorId String
  createdAt       DateTime @default(now())

  lodge         Lodge @relation(fields: [lodgeId], references: [id])
  user          User  @relation("InstrucaoUser", fields: [userId], references: [id])
  registradaPor User  @relation("InstrucaoRegistrador", fields: [registradaPorId], references: [id])

  @@index([lodgeId])
  @@index([userId])
  @@map("instrucoes")
}

// Visitas dos irmãos da Loja a outras oficinas — entram no histórico do membro
model VisitaExterna {
  id              String   @id @default(cuid())
  lodgeId         String
  userId          String // irmão que visitou
  date            DateTime
  lojaVisitada    String // nome (e nº) da oficina visitada
  potencia        String?
  oriente         String?
  observacao      String? // tipo de sessão, grau, motivo etc.
  certificadoDriveId String? // certificado de visita arquivado no Drive da Loja
  registradaPorId String
  createdAt       DateTime @default(now())

  lodge         Lodge @relation(fields: [lodgeId], references: [id])
  user          User  @relation("VisitaExternaUser", fields: [userId], references: [id])
  registradaPor User  @relation("VisitaExternaRegistrador", fields: [registradaPorId], references: [id])

  @@index([lodgeId])
  @@index([userId])
  @@map("visitas_externas")
}

enum AtaStatus {
  RASCUNHO
  EM_VALIDACAO // enviada aos irmãos para validação antes das assinaturas
  AGUARDANDO_ASSINATURAS
  ASSINADA // VM + Secretário assinaram — imutável
}

// Ata (Balaústre) — trava: exige assinatura conjunta de VM e Secretário
model Ata {
  id        String    @id @default(cuid())
  lodgeId   String
  sessionId String    @unique
  number    Int // numeração sequencial por loja
  content   String
  status    AtaStatus @default(RASCUNHO)

  signedByMasterId String?
  signedByMasterAt DateTime?
  signedBySecId    String?
  signedBySecAt    DateTime?

  driveFileId      String?   // PDF assinado no Google Drive

  // Assinatura digital gov.br (PAdES) — cada assinante assina com a própria conta
  govbrPdf      Bytes?    // PDF com as assinaturas digitais acumuladas
  govbrMasterAt DateTime? // assinatura gov.br do Venerável Mestre
  govbrSecAt    DateTime? // assinatura gov.br do Secretário
  govbrUploadedAt DateTime? // upload do PDF assinado externamente no assinador.iti.br
  govbrSolicitado Boolean   @default(false) // Secretário optou por encaminhar ao gov.br
  ajustes          String?   // ajustes solicitados pelos irmãos na validação
  sentForReviewAt  DateTime? // envio aos irmãos para validação (antes das assinaturas)
  sentToMembersAt  DateTime? // envio da versão final assinada aos irmãos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lodge          Lodge        @relation(fields: [lodgeId], references: [id])
  session        LodgeSession @relation(fields: [sessionId], references: [id])
  signedByMaster User?        @relation("AtaMaster", fields: [signedByMasterId], references: [id])
  signedBySec    User?        @relation("AtaSecretary", fields: [signedBySecId], references: [id])

  @@unique([lodgeId, number])
  @@map("atas")
}

// ─────────────── Documentos e Pranchas ───────────────

// Correspondência expedida com numeração sequencial automática
model Prancha {
  id          String   @id @default(cuid())
  lodgeId     String
  number      Int // sequencial por loja/ano
  year        Int
  subject     String
  recipient   String
  content     String
  driveFileId String?
  govbrPdf      Bytes?    // anexo assinado no assinador.iti.br
  govbrSignedAt DateTime? // upload do anexo assinado (gov.br)
  enviadaAt     DateTime? // envio por e-mail (Guarda dos Selos ou outro destino)
  createdAt   DateTime @default(now())

  lodge      Lodge               @relation(fields: [lodgeId], references: [id])
  processo   ProcessoDocumento?
  progressao ProcessoProgressao?
  admissao   ProcessoAdmissao?

  @@unique([lodgeId, year, number])
  @@map("pranchas")
}

// ─────────── Processos: cadeia ordenada de assinaturas gov.br ───────────
// Motor genérico da Secretaria para documentos oficiais (anexos de pranchas,
// formulários GOB etc.): o Secretário define a ordem dos cargos assinantes e
// o Venerável Mestre é SEMPRE o último. Todas as assinaturas são gov.br
// (OAuth ITI ou upload do portal assinador.iti.br), embutidas no PDF (PAdES).

enum StatusProcessoDoc {
  EM_ASSINATURA
  ASSINADO
}

model ProcessoDocumento {
  id          String            @id @default(cuid())
  lodgeId     String
  titulo      String
  // Documento base em PDF (guardado no banco, como os demais anexos)
  arquivo     Bytes
  arquivoNome String
  // Versão com as assinaturas PAdES do ITI embutidas (incremental)
  govbrPdf    Bytes?
  driveFileId String? // versão final assinada no Google Drive da Loja
  status      StatusProcessoDoc @default(EM_ASSINATURA)
  criadoPorId String
  // Vínculo opcional com a prancha de origem — ao concluir, a versão
  // assinada volta para a prancha (govbrPdf/govbrSignedAt)
  pranchaId   String?           @unique
  // Envio após todas as assinaturas: o Secretário escolhe o destinatário
  // (Guarda dos Selos em destaque) e pode copiar irmãos do quadro
  enviadoAt   DateTime?
  enviadoPara String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lodge      Lodge               @relation(fields: [lodgeId], references: [id])
  criadoPor  User                @relation("ProcessoCriadoPor", fields: [criadoPorId], references: [id])
  prancha    Prancha?            @relation(fields: [pranchaId], references: [id])
  assinantes ProcessoAssinante[]

  @@index([lodgeId])
  @@map("processo_documentos")
}

model ProcessoAssinante {
  id          String    @id @default(cuid())
  documentoId String
  ordem       Int // 1..n — o último é sempre o Venerável Mestre
  // Chave do cargo (CARGOS_PROCESSO em lib/processos.ts): nível de acesso
  // (SECRETARIO, TESOUREIRO, VENERAVEL_MESTRE) ou cargo do rito
  // (ORADOR, VIGILANTE_1, VIGILANTE_2), resolvido pelo cargoRito do usuário
  cargo       String
  signedById  String?
  signedAt    DateTime?

  documento ProcessoDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  signedBy  User?             @relation("ProcessoAssinanteUser", fields: [signedById], references: [id])

  @@unique([documentoId, ordem])
  @@map("processo_assinantes")
}

// ─────────────── Mútua (CABM) — Declaração de Beneficiários ───────────────
// Form. 108 entregue pelo irmão à Secretaria. Uma entrega vigente por membro
// (reenvio substitui a anterior). Filiados não entregam aqui — a Declaração
// fica na loja-mãe, onde recolhem a Mútua. Entregas feitas em papel antes da
// implantação do sistema são registradas sem arquivo (entregueAntes = true,
// flag do Secretário/VM); o anexo passa a existir se o irmão reenviar.
model MutuaEntrega {
  id        String   @id @default(cuid())
  lodgeId   String
  userId    String   @unique
  nome      String? // nome original do arquivo anexado
  mimeType  String?
  sizeBytes Int?
  arquivo   Bytes?
  // Entrega anterior ao sistema, marcada pelo Secretário ou VM (sem anexo)
  entregueAntes Boolean @default(false)
  marcadaPor    String? // nome de quem marcou a entrega anterior
  enviadaAt DateTime @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([lodgeId])
  @@map("mutua_entregas")
}

enum DocumentType {
  ATA_ESCANEADA
  HISTORICO
  REGULAMENTO
  FINANCEIRO
  OUTRO
}

model Document {
  id           String       @id @default(cuid())
  lodgeId      String
  uploadedById String
  title        String
  type         DocumentType @default(OUTRO)
  grauMinimo   Degree       @default(APRENDIZ) // grau mínimo para ver o documento
  driveFileId  String // arquivo no Google Drive da Loja
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime     @default(now())

  lodge      Lodge @relation(fields: [lodgeId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([lodgeId])
  @@map("documents")
}

// ─────────────── Biblioteca Digital ───────────────

enum BibliotecaCategoria {
  LIVRO
  RITUAL
  DECRETO
  REGULAMENTO
  ATA_HISTORICA
  PRANCHA
  OUTRO
}

// Acervo digital da Loja (livros, rituais, decretos, regulamentos) —
// leitura por todos os obreiros; upload/remoção pela Secretaria/VM.
// Arquivo guardado no banco (independe do Google Drive conectado).
model BibliotecaItem {
  id           String              @id @default(cuid())
  lodgeId      String
  uploadedById String
  titulo       String
  autor        String?
  categoria    BibliotecaCategoria @default(OUTRO)
  descricao    String?
  arquivo      Bytes
  textoExtraido String? // texto do PDF/arquivo para a busca full-text do Assistente
  grauMinimo   Degree   @default(APRENDIZ) // grau mínimo para ver o item
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())

  lodge      Lodge @relation(fields: [lodgeId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([lodgeId])
  @@map("biblioteca_itens")
}

// ─────────────── Tesouraria ───────────────

enum InvoiceStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  DINHEIRO
  MANUAL
}

// Mensalidade (capitação) gerada automaticamente para membros ativos
model Invoice {
  id             String        @id @default(cuid())
  lodgeId        String
  userId         String
  description    String // ex.: "Capitação 07/2026"
  referenceMonth Int
  referenceYear  Int
  amountCents    Int
  dueDate        DateTime
  status         InvoiceStatus @default(PENDENTE)

  // Pix dinâmico
  pixTxid         String?        @unique // id da cobrança no PSP (chave do webhook)
  pixCopiaECola   String?
  paidAt          DateTime?
  paidMethod      PaymentMethod?
  gatewayChargeId   String? @unique // id do pagamento no gateway (chave do webhook Asaas)
  gatewayInvoiceUrl String? // link de pagamento (boleto/cartão/Pix) no gateway

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge       Lodge        @relation(fields: [lodgeId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction?

  @@unique([lodgeId, userId, referenceYear, referenceMonth])
  @@index([lodgeId])
  @@map("invoices")
}

enum ExpenseStatus {
  PENDENTE_APROVACAO
  APROVADA // VM + Tesoureiro aprovaram
  PAGA
  REJEITADA
}

// Despesa — trava: exige aprovação dupla de VM e Tesoureiro
model Expense {
  id          String        @id @default(cuid())
  lodgeId     String
  description String
  supplier    String?
  amountCents Int
  dueDate     DateTime?
  category    String? // categoria financeira — propagada ao livro-caixa no pagamento
  status      ExpenseStatus @default(PENDENTE_APROVACAO)

  approvedByMasterId    String?
  approvedByMasterAt    DateTime?
  approvedByTreasurerId String?
  approvedByTreasurerAt DateTime?
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge               Lodge        @relation(fields: [lodgeId], references: [id])
  approvedByMaster    User?        @relation("ExpenseMaster", fields: [approvedByMasterId], references: [id])
  approvedByTreasurer User?        @relation("ExpenseTreasurer", fields: [approvedByTreasurerId], references: [id])
  transaction         Transaction?

  @@index([lodgeId])
  @@map("expenses")
}

enum TransactionType {
  RECEITA
  DESPESA
}

// Livro-caixa consolidado — base dos balancetes mensais
model Transaction {
  id          String          @id @default(cuid())
  lodgeId     String
  type        TransactionType
  description String
  amountCents Int
  date        DateTime
  category    String? // capitação, tronco, evento, aluguel...
  invoiceId   String?         @unique
  expenseId   String?         @unique
  donationId  String?         @unique
  createdAt   DateTime        @default(now())

  lodge    Lodge     @relation(fields: [lodgeId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])
  expense  Expense?  @relation(fields: [expenseId], references: [id])
  donation Donation? @relation(fields: [donationId], references: [id])

  @@index([lodgeId, date])
  @@map("transactions")
}

// Categorias financeiras (tags) por Loja — para receitas e despesas;
// Transaction.category continua string (convive com lançamentos automáticos)
model CategoriaFinanceira {
  id        String          @id @default(cuid())
  lodgeId   String
  nome      String
  tipo      TransactionType
  createdAt DateTime        @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id])

  @@unique([lodgeId, nome, tipo])
  @@map("categorias_financeiras")
}

enum DonationType {
  TRONCO_SOLIDARIEDADE
  INGRESSO_EVENTO
  DOACAO_AVULSA
}

// Arrecadações extras: tronco e eventos beneficentes
model Donation {
  id          String       @id @default(cuid())
  lodgeId     String
  userId      String? // anônimo se null
  eventId     String?
  type        DonationType
  amountCents Int
  date        DateTime     @default(now())

  lodge       Lodge         @relation(fields: [lodgeId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])
  event       CharityEvent? @relation(fields: [eventId], references: [id])
  transaction Transaction?

  @@index([lodgeId])
  @@map("donations")
}

model CharityEvent {
  id               String   @id @default(cuid())
  lodgeId          String
  name             String
  date             DateTime
  ticketPriceCents Int?
  createdAt        DateTime @default(now())

  lodge     Lodge      @relation(fields: [lodgeId], references: [id])
  donations Donation[]

  @@index([lodgeId])
  @@map("charity_events")
}

// ─────────────── Módulo Secretaria: Kanban (loja.md §4) ───────────────

enum StatusAdmissao {
  DOCUMENTACAO
  EDITAL_PUBLICADO
  SINDICANCIA
  ESCRUTINIO
  AGUARDANDO_PLACET
  INICIADO
  REPROVADO
}

// Pipeline de Admissão (Iniciação) — candidato profano até virar obreiro
model ProcessoAdmissao {
  id               String         @id @default(cuid())
  lodgeId          String
  nomeCandidato    String
  cpf              String?
  email            String?
  phone            String?
  fotoUrl          String? // foto do candidato (data URI, até 500 KB)
  status           StatusAdmissao @default(DOCUMENTACAO)
  certidoesValidas Boolean        @default(false)
  dataEscrutinio   DateTime?
  aprovado         Boolean?
  observacoes      String?
  // Irmão que apadrinha (indica) o candidato — qualquer membro pode abrir o
  // cadastro inicial; null nos processos abertos pela Secretaria
  padrinhoId       String?
  // Token opaco do link público entregue ao candidato (/candidato/<token>):
  // ele baixa os formulários de indicação e anexa os preenchidos
  token            String         @unique @default(cuid())
  // Prancha do pedido de Placet de Iniciação expedida ao entrar em
  // AGUARDANDO_PLACET — INICIADO só com ela assinada (Processos) e enviada
  pranchaId        String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lodge    Lodge             @relation(fields: [lodgeId], references: [id])
  padrinho User?             @relation("AdmissaoPadrinho", fields: [padrinhoId], references: [id])
  prancha  Prancha?          @relation(fields: [pranchaId], references: [id])
  anexos   CandidatoAnexo[]

  @@index([lodgeId])
  @@map("processos_admissao")
}

// Formulários de indicação preenchidos, anexados pelo próprio candidato no
// link público ou pelo padrinho/Secretaria. Guardados no banco (independem
// do Google Drive conectado).
model CandidatoAnexo {
  id         String   @id @default(cuid())
  processoId String
  nome       String // nome original do arquivo
  mimeType   String
  sizeBytes  Int
  arquivo    Bytes
  // Quem anexou: "candidato" (link público) ou o nome do irmão
  enviadoPor String
  createdAt  DateTime @default(now())

  processo ProcessoAdmissao @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([processoId])
  @@map("candidato_anexos")
}

enum StatusPlacet {
  PENDENTE
  EM_ANALISE
  APROVADO
  NEGADO
}

// Quitte Placet (desligamento/filiação) — qualquer irmão do quadro solicita,
// anexando a carta escrita a próprio punho e assinada. Travas: Nada Consta da
// Tesouraria e dupla assinatura gov.br em ordem — Secretário e, por último,
// o Venerável Mestre.
model QuittePlacet {
  id                 String       @id @default(cuid())
  userId             String
  lodgeId            String
  motivo             String?
  dataSolicitacao    DateTime     @default(now())
  quitacaoFinanceira Boolean      @default(false)
  status             StatusPlacet @default(PENDENTE)

  signedByMasterId String?
  signedByMasterAt DateTime?
  signedBySecId    String?
  signedBySecAt    DateTime?
  // Orador (cargo do rito, User.cargoRito) — assina entre o Secretário e o VM
  signedByOradorId String?
  signedByOradorAt DateTime?

  // Carta de próprio punho (foto/PDF) anexada pelo irmão junto do pedido —
  // obrigatória; sem ela as assinaturas ficam bloqueadas
  cartaArquivo Bytes?
  cartaNome    String?
  cartaMime    String?
  // Sessão em que o pedido foi comunicado à Loja e a ata dessa sessão
  // (registradas pela Secretaria em Processos) — exigidas antes das assinaturas
  dataSessaoComunicacao DateTime?
  ataArquivo            Bytes?
  ataNome               String?
  ataMime               String?
  // Form. 122 com as assinaturas PAdES do ITI (gov.br) embutidas
  govbrPdf     Bytes?

  driveFileId String?
  // Formulário oficial (Form. 122) preenchido e assinado, anexado pela
  // Secretaria; guardado no banco para poder ser reenviado a qualquer momento.
  // Colunas inline (não um model de anexo como CandidatoAnexo) de propósito:
  // o processo tem exatamente UM formulário, substituível, lido junto da linha
  formularioArquivo   Bytes?
  formularioNome      String?
  formularioMime      String?
  formularioEnviadoAt DateTime? // envio à Guarda dos Selos por e-mail
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User  @relation(fields: [userId], references: [id])
  lodge          Lodge @relation(fields: [lodgeId], references: [id])
  signedByMaster User? @relation("QuittePlacetMaster", fields: [signedByMasterId], references: [id])
  signedBySec    User? @relation("QuittePlacetSecretary", fields: [signedBySecId], references: [id])
  signedByOrador User? @relation("QuittePlacetOrador", fields: [signedByOradorId], references: [id])

  @@index([lodgeId])
  @@map("quitte_placets")
}

// Atestado de Regularidade: o irmão solicita e o documento segue para a tripla
// assinatura — Tesoureiro, depois Secretário e por último o Venerável Mestre —
// sempre pelo gov.br (OAuth ou upload do portal ITI).
// O PDF é gerado sob demanda a partir dos dados; govbrPdf guarda a versão
// com assinaturas PAdES do ITI quando algum assinante usa o gov.br.
enum StatusAtestado {
  SOLICITADO
  ASSINADO
}

model AtestadoRegularidade {
  id           String         @id @default(cuid())
  userId       String
  lodgeId      String
  status       StatusAtestado @default(SOLICITADO)
  solicitadoAt DateTime       @default(now())

  signedByTesId    String?
  signedByTesAt    DateTime?
  signedBySecId    String?
  signedBySecAt    DateTime?
  signedByMasterId String?
  signedByMasterAt DateTime?
  govbrPdf         Bytes?
  driveFileId      String? // PDF final arquivado no Google Drive da Loja

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User  @relation("AtestadoUser", fields: [userId], references: [id])
  lodge          Lodge @relation(fields: [lodgeId], references: [id])
  signedByTes    User? @relation("AtestadoTes", fields: [signedByTesId], references: [id])
  signedBySec    User? @relation("AtestadoSec", fields: [signedBySecId], references: [id])
  signedByMaster User? @relation("AtestadoMaster", fields: [signedByMasterId], references: [id])

  @@map("atestados_regularidade")
}

enum StatusProgressao {
  CUMPRIMENTO_INTERSTICIO
  INSTRUCAO_E_FREQUENCIA
  EXAME_PROFICIENCIA
  ESCRUTINIO_PROGRESSAO
  AGUARDANDO_PLACET
  AGUARDANDO_CERIMONIA
  COMUNICACAO_POS_CERIMONIA
  GRAU_CONCEDIDO
}

// Pipeline de Progressão de Graus (loja.md §4.B) — travas da Guarda dos
// Selos (placetDeferido) e da comunicação de 15 dias (comunicadoEnviado)
model ProcessoProgressao {
  id                String           @id @default(cuid())
  userId            String
  lodgeId           String
  grauAlvo          Degree // COMPANHEIRO ou MESTRE
  status            StatusProgressao @default(CUMPRIMENTO_INTERSTICIO)

  dataInicio        DateTime         @default(now())
  dataAprovacao     DateTime? // data que passou no escrutínio
  placetDeferido    Boolean          @default(false) // trava da Guarda dos Selos
  dataCerimonia     DateTime? // data da Elevação ou Exaltação
  comunicadoEnviado Boolean          @default(false) // trava dos 15 dias (Sua Sessão no GOB-SP)
  // Prancha do pedido de Placet expedida ao entrar em AGUARDANDO_PLACET —
  // o kanban só avança com ela assinada (Processos) e enviada
  pranchaId         String?          @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  lodge   Lodge    @relation(fields: [lodgeId], references: [id])
  prancha Prancha? @relation(fields: [pranchaId], references: [id])

  @@index([lodgeId])
  @@map("processos_progressao")
}

// Pedido de Afastamento (licença do quadro de obreiros — Form. 116 do GOB).
// O irmão faz o pedido e assina o REQUERIMENTO com a sua conta gov.br; a Loja
// delibera em sessão; a Secretaria registra a sessão e o artigo do Regulamento,
// o sistema gera o Form. 116 (comunicação à Guarda dos Selos) que recebe as
// assinaturas gov.br do Secretário e, por último, do Venerável Mestre; após o
// envio à Guarda dos Selos o irmão passa a LICENCIADO.
enum StatusAfastamento {
  AGUARDANDO_OBREIRO // requerimento gerado, falta a assinatura gov.br do irmão
  SOLICITADO // requerimento assinado — aguarda deliberação/registro da Secretaria
  EM_ASSINATURA // Form. 116 gerado — assinaturas Secretário → VM
  ASSINADO // Form. 116 assinado pelos dois cargos (enviado quando enviadoAt)
  INDEFERIDO
}

model PedidoAfastamento {
  id        String            @id @default(cuid())
  lodgeId   String
  userId    String
  motivo    String
  dias      Int
  // data a partir da qual o irmão pretende afastar-se (informativa; a licença
  // conta a partir da sessão que a concedeu, como manda o Form. 116)
  dataInicio DateTime?
  status    StatusAfastamento @default(AGUARDANDO_OBREIRO)

  // Requerimento do obreiro com a assinatura PAdES gov.br dele embutida
  requerimentoPdf      Bytes?
  requerimentoSignedAt DateTime?

  // Registro da Secretaria após a deliberação em sessão
  dataSessao DateTime?
  artigo     String? // "67" ou "68" (Regulamento Geral da Federação)
  // Form. 116 gerado pelo sistema (PDF base) e a versão com as assinaturas gov.br
  formularioPdf Bytes?
  govbrPdf      Bytes?

  signedBySecId    String?
  signedBySecAt    DateTime?
  signedByMasterId String?
  signedByMasterAt DateTime?

  enviadoAt   DateTime?
  enviadoPara String?
  driveFileId String?
  parecer     String? // motivo do indeferimento
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User  @relation("AfastamentoUser", fields: [userId], references: [id])
  lodge          Lodge @relation(fields: [lodgeId], references: [id])
  signedBySec    User? @relation("AfastamentoSec", fields: [signedBySecId], references: [id])
  signedByMaster User? @relation("AfastamentoMaster", fields: [signedByMasterId], references: [id])

  @@index([lodgeId, status])
  @@index([userId])
  @@map("pedidos_afastamento")
}

enum NotificationType {
  PENDING_SIGNATURE
  DEADLINE_WARNING
  MISSING_DATA
  FINANCIAL_APPROVAL
  BIRTHDAY
}

// Central de alertas (to-do de assinaturas, prazos de 15 dias, cadastro incompleto)
model Notification {
  id          String           @id @default(cuid())
  lodgeId     String
  userId      String?
  title       String
  description String
  type        NotificationType
  isRead      Boolean          @default(false)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  // Chave determinística da origem (ex.: "ata:<id>") — garante geração idempotente
  sourceKey   String?
  // Rota interna do recurso relacionado (ex.: "/secretaria/atas/<id>")
  link        String?
  // Momento em que o lembrete por e-mail foi enviado (null = ainda não)
  emailedAt   DateTime?

  lodge Lodge @relation(fields: [lodgeId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@unique([lodgeId, sourceKey])
  @@index([lodgeId])
  @@map("notifications")
}

// ─────────────── Assistente IA (chatbot) ───────────────
// Histórico de conversas do assistente por usuário. O conteúdo fica no
// banco para retomada da conversa e para o limite diário de perguntas;
// a retenção/limpeza roda pela fila (lib/fila.ts).
model AssistenteConversa {
  id        String   @id @default(cuid())
  lodgeId   String
  userId    String
  titulo    String? // primeira pergunta, encurtada
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge     Lodge                @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensagens AssistenteMensagem[]

  @@index([lodgeId, userId])
  @@map("assistente_conversas")
}

model AssistenteMensagem {
  id         String   @id @default(cuid())
  conversaId String
  role       String // "user" | "assistant"
  content    String
  createdAt  DateTime @default(now())

  conversa AssistenteConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, createdAt])
  @@map("assistente_mensagens")
}

// Trilha de auditoria: quem alterou o quê (membros, baixas, configs, roles).
// Sem FK de propósito — a trilha sobrevive à exclusão da loja/usuário.
model AuditEvent {
  id         String   @id @default(cuid())
  lodgeId    String? // null = evento de plataforma (super admin)
  userId     String? // null = sistema (webhook, cron)
  userName   String // snapshot do ator no momento (nome, "Webhook Asaas"…)
  acao       String // slug, ex.: "membro.criar", "mensalidade.baixa"
  entidade   String? // tipo do alvo, ex.: "User", "Invoice"
  entidadeId String?
  detalhes   Json? // campos relevantes (nunca segredos)
  createdAt  DateTime @default(now())

  @@index([lodgeId, createdAt])
  @@map("audit_events")
}

// Fila persistente de tarefas (#13): envios de e-mail em massa e outros
// trabalhos lentos saem do request e ganham retry. Worker: /api/cron/fila.
// Sem FK de propósito — jobs sobrevivem a exclusões e não travam deletes.
model Job {
  id            String    @id @default(cuid())
  tipo          String // handler registrado em lib/fila.ts, ex.: "sessao.convites"
  payload       Json // parâmetros do handler (ids, nunca blobs)
  status        JobStatus @default(PENDENTE)
  tentativas    Int       @default(0)
  maxTentativas Int       @default(5)
  executarEm    DateTime  @default(now()) // backoff reagenda para o futuro
  ultimoErro    String?
  lodgeId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, executarEm])
  @@map("jobs")
}

enum JobStatus {
  PENDENTE
  PROCESSANDO
  OK
  FALHOU
}
