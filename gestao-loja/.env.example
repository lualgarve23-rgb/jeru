# Copie para .env e preencha. Nunca versionar o .env real.
# Gerar AUTH_SECRET:  openssl rand -base64 32

DATABASE_URL="postgresql://USER:PASS@localhost:5432/gestao_loja"

# Obrigatório em produção — mínimo 32 bytes aleatórios
AUTH_SECRET=""
AUTH_URL="https://noprumo.ia.br"
APP_URL="https://noprumo.ia.br"

# Opcional: chave dedicada para cifrar segredos no banco (Asaas, Gmail,
# refresh tokens Google). Se omitida, usa AUTH_SECRET.
# SECRETS_ENCRYPTION_KEY=""

# Gmail fallback (opcional se cada loja configurar o próprio)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GUARDA_SELOS_EMAIL=""

# Webhooks / cron — obrigatórios em produção (rejeitados se vazios)
CRON_SECRET=""
PIX_WEBHOOK_SECRET=""
ASAAS_PLATFORM_WEBHOOK_TOKEN=""
# ASAAS_PLATFORM_API_KEY=""

# Google OAuth (Drive da loja / backup)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Diretório das fotos/assinaturas em disco (lib/media); fora do repo
MEDIA_DIR=

# Alertas de cron/webhook (#14) — destino dos e-mails de falha crítica
# (senão usa GMAIL_USER)
# ALERT_EMAIL=""

# Assinatura Eletrônica gov.br (API do ITI) — credenciais do termo de adesão.
# Em produção AUTH_URL/API_URL são OBRIGATÓRIAS (sem elas a assinatura falha
# com erro claro em vez de cair na homologação por engano):
#   produção:    https://cas.iti.br / https://assinatura-api.iti.br
#   homologação: https://cas.staging.iti.br / https://assinatura-api.staging.iti.br
GOVBR_SIGN_CLIENT_ID=""
GOVBR_SIGN_CLIENT_SECRET=""
GOVBR_SIGN_AUTH_URL=""
GOVBR_SIGN_API_URL=""
# GOVBR_SIGN_SCOPE="sign"

# API Asaas (cobranças das lojas e licenças da plataforma). Obrigatória em
# produção: https://api.asaas.com/v3 — sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=""

# Assistente IA (Claude) — chave da API e modelo (opcional; tem padrão no código)
ANTHROPIC_API_KEY=""
# ASSISTENTE_MODEL=""

# Pasta raiz no Drive da conta Google de fallback (GMAIL_USER) onde ficam as
# pastas das lojas sem conta própria conectada (opcional; sem ela a pasta
# da loja é criada na raiz da conta)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=""
